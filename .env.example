# Copy to .env and fill in real values:
#   cp .env.example .env

NODE_ENV=development
PORT=4000

# PostgreSQL (required)
# Local: localhost. Coolify: hostname service Postgres (bukan localhost), DB harus sudah dibuat.
# Error 3D000 = nama database di path URL belum ada di server.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/claimora

# JWT (required — min 10 characters each)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis — BullMQ extraction worker (required)
# Option A: URL (recommended if Redis has password / TLS / managed service)
# Format: redis://[username]:[password]@[host]:[port]/[db]
# REDIS_URL=redis://default:YOUR_PASSWORD@your-redis-host.example.com:6379/0
#
# Option B: host + port (+ optional auth)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=YOUR_PASSWORD
# REDIS_DB=0

# Local file storage (logs) + object storage driver
STORAGE_PATH=./storage
STORAGE_DRIVER=s3

# Amazon S3 / S3-compatible object storage (required when STORAGE_DRIVER=s3)
S3_BUCKET=your-bucket-name
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional — MinIO, R2, etc.
# S3_ENDPOINT=https://s3.example.com
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=claimora
S3_UPLOAD_PREFIX=uploads
S3_AVATAR_PREFIX=avatars
S3_PROCESSED_PREFIX=processed
# Optional public CDN base (if not using API proxy for avatars)
# S3_PUBLIC_BASE_URL=https://cdn.example.com/claimora

# HTTP rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# LLM post-processing (optional)
ENABLE_LLM_POST_PROCESS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OCR_MAX_CHARS=24000
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=16384
BILLING_MISMATCH_TOLERANCE_PERCENT=2

# OCR gate & logging
OCR_MIN_TEXT_CHARS=80
PDF_OCR_MAX_PAGES=12
OCR_LANGUAGES=eng+ind
OCR_LOG_PREVIEW_CHARS=3000
LOG_OCR_TO_FILE=true

# ABBYY Vantage OCR (required for extraction)
ABBYY_BASE_URL=https://vantage-au.abbyy.com
ABBYY_CLIENT_ID=
ABBYY_CLIENT_SECRET=
ABBYY_SKILL_ID=
ABBYY_SKILL_NAME=ocr
ABBYY_POLL_INTERVAL_MS=2000
ABBYY_TRANSACTION_TIMEOUT_MS=300000

# Per-organization monthly OCR quota (new orgs / seed)
OCR_CREDITS_MONTHLY_QUOTA=16000

# Transaction outbox relay (DB → BullMQ)
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_PUBLISH_ATTEMPTS=10

# Redis distributed locks (multi-instance leader election)
DISTRIBUTED_LOCK_KEY_PREFIX=claimora:lock
DISTRIBUTED_LOCK_TTL_MS=30000

# Circuit breaker (ABBYY + OpenAI external APIs)
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000
CIRCUIT_BREAKER_HALF_OPEN_SUCCESS_THRESHOLD=2

# Bulkhead — isolate concurrent resource pools
BULKHEAD_ENABLED=true
BULKHEAD_ABBYY_MAX_CONCURRENT=3
BULKHEAD_ABBYY_MAX_WAITING=10
BULKHEAD_ABBYY_ACQUIRE_TIMEOUT_MS=120000
BULKHEAD_OPENAI_MAX_CONCURRENT=5
BULKHEAD_OPENAI_MAX_WAITING=20
BULKHEAD_OPENAI_ACQUIRE_TIMEOUT_MS=120000
BULKHEAD_EXTRACTION_WORKER_CONCURRENCY=2

# Structured logging, retention & centralized collector
LOG_DIR=./storage/logs
LOG_SERVICE_NAME=claimora-backend
LOG_LEVEL=info
LOG_STRUCTURED_CONSOLE=false
LOG_MAX_FILE_SIZE=20m
LOG_RETENTION_DAYS=14d
LOG_ERROR_RETENTION_DAYS=90d
LOG_AUDIT_RETENTION_DAYS=365d
LOG_CENTRAL_ENABLED=false
# LOG_CENTRAL_URL=https://your-log-collector.example.com/ingest
# LOG_CENTRAL_API_KEY=
