  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const path=require('path');const src='src/modules/extraction/prompts';const dest='dist/modules/extraction/prompts';fs.mkdirSync(path.dirname(dest),{recursive:true});fs.cpSync(src,dest,{recursive:true});\"",
    "start": "node -r ./register-paths.cjs dist/server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "seed:super-admin": "tsx -r tsconfig-paths/register src/scripts/create-super-admin.ts",
    "fix:claims-schema": "tsx -r tsconfig-paths/register src/scripts/fix-claims-created-by-column.ts",
    "fix:ocr-credits-schema": "tsx -r tsconfig-paths/register src/scripts/fix-ocr-credits-schema.ts",
    "abbyy:list-skills": "tsx -r tsconfig-paths/register src/scripts/list-abbyy-skills.ts"
  },
